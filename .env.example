# ── Datenbank ──────────────────────────────────────────────────────────────
POSTGRES_DB=learnai
POSTGRES_USER=learnai
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+psycopg://learnai:change-me-strong-password@db:5432/learnai

# ── Verschlüsselung (32 Bytes, Base64) ───────────────────────────────────────
ENCRYPTION_MASTER_KEY=

# ── Auth / Sessions ─────────────────────────────────────────────────────────
SESSION_SECRET=
SESSION_TTL_SEC=28800
PBKDF2_ITERATIONS=600000

# ── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# Produktion hinter HTTPS:
# CORS_ORIGINS=https://your-domain.example
# COOKIE_SECURE=true

DEFAULT_TENANT_SLUG=default
ALLOW_REGISTRATION=false

# Login-Schutz (Redis) — unbekannte E-Mails werden dauerhaft gesperrt (Allowlist)
LOGIN_ALLOWLIST_ONLY=true
# Nur von diesen Proxy-IPs X-Forwarded-For vertrauen (Docker/nginx, Standard reicht meist)
# TRUSTED_PROXY_CIDRS=127.0.0.0/8,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# ── Uploads / Worker ────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
REDIS_URL=redis://redis:6379/0

# ── KI ──────────────────────────────────────────────────────────────────────
# Chat/Vision: ollama | openai | anthropic
LLM_PROVIDER=ollama
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
# leer = erstes Vision-Modell aus /api/tags (llava, llama3.2-vision, …)
OLLAMA_VISION_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-0
TTS_PROVIDER=openai
