# ── Datenbank ──────────────────────────────────────────────────────────────
POSTGRES_DB=learnai
POSTGRES_USER=learnai
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+psycopg://learnai:change-me-strong-password@db:5432/learnai

# ── Verschlüsselung (32 Bytes, Base64) ───────────────────────────────────────
ENCRYPTION_MASTER_KEY=

# ── Auth / Sessions ─────────────────────────────────────────────────────────
SESSION_SECRET=
SESSION_TTL_SEC=28800
PBKDF2_ITERATIONS=600000

# ── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Port-Bind auf dem Host: 127.0.0.1 (nginx lokal) | LAN-IP (nginx CT 108) | 0.0.0.0
# Produktion learn.example.app (nginx CT 108 → CT 135):
# PUBLISH_BIND=192.168.131.45
CORS_ORIGINS=http://localhost:3000
APP_ENV=development
COOKIE_SECURE=false
# Produktion (Internet-Rollout):
# APP_ENV=production
# COOKIE_SECURE=true
# CORS_ORIGINS=https://your-domain.example

DEFAULT_TENANT_SLUG=default
ALLOW_REGISTRATION=false

# Login-Schutz (Redis) — unbekannte E-Mails werden dauerhaft gesperrt (Allowlist)
LOGIN_ALLOWLIST_ONLY=true
# Proxy-IP(s), von denen X-Real-IP / X-Forwarded-For vertraut wird.
# Entwicklung (breit): 127.0.0.0/8,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
# Produktion learn.example.app: nur nginx CT 108, z.B. TRUSTED_PROXY_CIDRS=192.168.131.108/32
# TRUSTED_PROXY_CIDRS=127.0.0.0/8,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# ── Uploads / Worker ────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
REDIS_URL=redis://redis:6379/0

# KI-Generierung — Parallelität & Rate-Limits (Redis)
GENERATE_MAX_ACTIVE_PER_USER=2
GENERATE_MAX_ACTIVE_PER_TENANT=5
GENERATE_RATE_LIMIT_PER_USER_HOUR=10

# ── KI ──────────────────────────────────────────────────────────────────────
# Chat/Vision: ollama | openai | anthropic
LLM_PROVIDER=ollama
# Ollama-URL: Container → Host oder anderer CT im LAN (nicht localhost im Container!)
# Linux: host.docker.internal erst mit extra_hosts in docker-compose (host-gateway)
# Oder direkt: OLLAMA_URL=http://192.168.131.60:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
OLLAMA_VISION_MODEL=
# Timeouts in Sekunden (Vision braucht bei grossen Modellen oft >180s)
OLLAMA_CHAT_TIMEOUT_SEC=900
OLLAMA_VISION_TIMEOUT_SEC=900
# Lokaler Whisper (faster-whisper, OpenAI-kompatibel) — vor OpenAI
WHISPER_URL=http://192.168.131.60:9000
WHISPER_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-0
TTS_PROVIDER=openai
